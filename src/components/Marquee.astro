---
// Scrolling band of short phrases, garnet or forest.
// The track holds two copies of the list and slides by half its width, so the loop is seamless.
// Screen readers get the list once; the animation stops when reduced motion is requested.
interface Props {
  items: string[];
  /** accent: garnet band (default) · primary: forest band */
  tone?: 'accent' | 'primary';
}

const { items, tone = 'accent' } = Astro.props;
---

<div class:list={['marquee', `marquee--${tone}`]}>
  <ul class="visually-hidden">
    {items.map((item) => <li>{item}</li>)}
  </ul>
  <div class="marquee__track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <span class="marquee__group">
          {items.map((item) => (
            <span>
              {item} <b>✺</b>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 0.7rem;
    border-block: var(--border-width) solid var(--primary);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2rem);
    text-transform: uppercase;
  }

  .marquee--primary {
    background: var(--primary);
    color: var(--on-primary);
  }

  .marquee--primary .marquee__group b {
    color: var(--accent-on-primary);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
    gap: 2rem;
    padding-right: 2rem;
    white-space: nowrap;
  }

  .marquee__group b {
    margin-left: 2rem;
    font-weight: 400;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee-scroll 30s linear infinite;
    }
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
