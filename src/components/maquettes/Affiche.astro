---
// Structure de la piste B « Affiche », déclinable en couleurs via `theme`.
// Maquette temporaire de l'étape 3 : à supprimer à l'étape 4.
import '@fontsource/archivo-black/400.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

export interface AfficheTheme {
  bg: string;
  ink: string;
  primary: string;
  onPrimary: string;
  accent: string;
  onAccent: string;
  accentOnPrimary: string;
  secondary: string;
  onSecondary: string;
  card: string;
  onCard: string;
  cardAccent: string;
  /** Bordures (boutons, bandeau, cartes). Par défaut : primary. */
  border?: string;
  /** Ombre portée des boutons. Par défaut : primary. */
  btnShadow?: string;
  /** Ombre portée de la carte mise en avant. Par défaut : primary. */
  featuredShadow?: string;
}

interface Props {
  title: string;
  theme: AfficheTheme;
  /** Titres plus petits et bandeau plus lent, pour un rendu moins « crié ». */
  calme?: boolean;
}

const { title, theme, calme = false } = Astro.props;

const style = [
  `--bg:${theme.bg}`,
  `--ink:${theme.ink}`,
  `--primary:${theme.primary}`,
  `--on-primary:${theme.onPrimary}`,
  `--accent:${theme.accent}`,
  `--on-accent:${theme.onAccent}`,
  `--accent-on-primary:${theme.accentOnPrimary}`,
  `--secondary:${theme.secondary}`,
  `--on-secondary:${theme.onSecondary}`,
  `--card:${theme.card}`,
  `--on-card:${theme.onCard}`,
  `--card-accent:${theme.cardAccent}`,
  `--border:${theme.border ?? theme.primary}`,
  `--btn-shadow:${theme.btnShadow ?? theme.primary}`,
  `--featured-shadow:${theme.featuredShadow ?? theme.primary}`,
].join(';');

const bandeau = ['Livrer sans stress', 'Vendredi sans peur', 'Le contrôle revient', 'Prix fixes, périmètre écrit'];
---

<BaseLayout title={title} description="Piste visuelle B pour l'accueil." noindex>
  <div class:list={['affiche', { calme }]} style={style}>
    <header class="nav wrap">
      <a class="logo" href="#">Guillaume Casbas</a>
      <nav aria-label="Navigation principale">
        <a href="#">Démarrer</a>
        <a href="#">Comment je travaille</a>
        <a href="#">À propos</a>
        <a class="btn btn-small" href="#">Me contacter</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>
          Livrer <mark>sans stress</mark>,<br />
          <span class="h1-small">même quand l'IA écrit le code.</span>
        </h1>
        <div class="hero-foot">
          <p class="lead">
            Je remets le contrôle dans vos livraisons : des process, des tests et du jugement,
            pour que votre équipe déploie sereinement.
          </p>
          <a class="btn" href="#">Envoyez-moi un message</a>
        </div>
      </section>

      <div class="marquee" aria-label={bandeau.join(' · ')}>
        <div class="marquee-track" aria-hidden="true">
          {[0, 1].map(() => (
            <span class="marquee-group">
              {bandeau.map((item) => (
                <span>{item} <b>✺</b></span>
              ))}
            </span>
          ))}
        </div>
      </div>

      <section class="constat">
        <div class="wrap">
          <p class="eyebrow">Le constat</p>
          <ol class="stairs">
            <li><strong>×3–4</strong> plus vite pour coder.</li>
            <li><strong>×3–4</strong> plus de features demandées.</li>
            <li><strong>×3–4</strong> plus de contexte à tenir.</li>
            <li><strong>×3–4</strong> plus de bugs.</li>
            <li>Et <strong>le même stress</strong>.</li>
          </ol>
          <p class="punch">Ce qui devait nous libérer nous épuise.</p>
          <p class="metier">Mon métier : remettre le contrôle dans ce circuit.</p>
        </div>
      </section>

      <section class="preuve wrap">
        <div class="zero">
          <span class="zero-num">0</span>
          <span class="zero-label">interruption de service en <strong>4 ans</strong> de lead tech chez Medelse, pour <strong>5 000+</strong> utilisateurs.</span>
        </div>
        <blockquote>
          <p>
            « Guillaume a été une personne clé au sein de Medelse pendant quatre ans. Il s'est
            distingué par son expertise technique, sa rigueur, son investissement et son esprit
            d'équipe. »
          </p>
          <footer>Thomas Gendron, ex-CEO de Medelse</footer>
        </blockquote>
      </section>

      <section class="offres" id="offres">
        <div class="wrap">
          <h2>Comment on démarre</h2>
          <p class="offres-sub">Prix fixes, périmètre écrit. Pas de surprise.</p>
          <div class="cards">
            <article class="card">
              <h3>Session stratégie</h3>
              <p class="price">300 €<small> HT</small></p>
              <p class="meta">90 min, à distance</p>
              <p>On échange : vous me racontez votre façon de livrer, et vous me montrez ce qui coince.</p>
              <p class="deliv">Compte rendu : où vous en êtes, les options, la priorité recommandée.</p>
              <a class="btn btn-outline" href="#">Prendre une session</a>
            </article>
            <article class="card card-featured">
              <span class="tag">Recommandé</span>
              <h3>Audit de livraison</h3>
              <p class="price">700 €<small> HT</small></p>
              <p class="meta">1 jour, sur place ou à distance</p>
              <p>Je constate par moi-même dans votre code et vos outils : pipeline, tests, déploiements, revues.</p>
              <p class="deliv">Compte rendu, plan d'action priorisé, checklists, restitution.</p>
              <a class="btn btn-primary" href="#">Réserver un audit</a>
            </article>
            <article class="card">
              <h3>Missions</h3>
              <p class="price price-text">Chiffré après l'audit ou la session</p>
              <p class="meta">Périmètre écrit, prix ferme</p>
              <ul>
                <li>Pipeline et tests critiques</li>
                <li>ATDD</li>
                <li>Lead tech à temps partiel</li>
              </ul>
              <a class="btn btn-outline" href="#">Commencer par l'audit</a>
            </article>
          </div>
        </div>
      </section>

      <section class="cta wrap">
        <h2>Vous déboguez en prod plus souvent que vous ne l'aimeriez&nbsp;?</h2>
        <a class="btn" href="#">Envoyez-moi un message, on regarde ça ensemble</a>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span>© Guillaume Casbas · Ce site ne collecte aucune donnée.</span>
        <a href="/maquettes">← Toutes les maquettes</a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
  }
  .affiche {
    --display: 'Archivo Black', 'Arial Black', sans-serif;
    --text: 'Archivo', system-ui, sans-serif;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--text);
    line-height: 1.5;
  }
  .wrap {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  a {
    color: inherit;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }
  .logo {
    font-family: var(--display);
    color: var(--primary);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .nav nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    font-weight: 600;
  }
  .nav nav a:not(.btn) {
    text-decoration: none;
  }

  /* Boutons */
  .btn {
    display: inline-block;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 3px solid var(--border);
    box-shadow: 4px 4px 0 var(--btn-shadow);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--btn-shadow);
  }
  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .btn-outline {
    background: var(--card);
    color: var(--on-card);
    border-color: var(--on-card);
    box-shadow: 4px 4px 0 var(--on-card);
  }
  .btn-primary {
    background: var(--primary);
    color: var(--on-primary);
    box-shadow: 4px 4px 0 var(--featured-shadow);
  }

  /* Hero */
  .hero {
    padding-top: clamp(2rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
  }
  h1 {
    font-family: var(--display);
    font-weight: 400;
    color: var(--primary);
    text-transform: uppercase;
    font-size: clamp(2.8rem, 10.5vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }
  mark {
    background: var(--accent);
    color: var(--on-accent);
    padding: 0 0.1em;
  }
  .h1-small {
    display: block;
    margin-top: 0.3em;
    font-size: 0.42em;
    line-height: 1;
  }
  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    max-width: 36rem;
    margin: 0;
  }

  /* Bandeau défilant */
  .marquee {
    overflow: hidden;
    background: var(--accent);
    color: var(--on-accent);
    border-top: 3px solid var(--border);
    border-bottom: 3px solid var(--border);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(1.2rem, 3vw, 2rem);
    padding: 0.7rem 0;
  }
  .marquee-track {
    display: flex;
    width: max-content;
  }
  .marquee-group {
    display: flex;
    gap: 2rem;
    padding-right: 2rem;
    white-space: nowrap;
  }
  .marquee-group b {
    font-weight: 400;
    margin-left: 2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: defile 30s linear infinite;
    }
  }
  @keyframes defile {
    to {
      transform: translateX(-50%);
    }
  }

  /* Constat */
  .constat {
    background: var(--primary);
    color: var(--on-primary);
    padding: clamp(3rem, 9vw, 7rem) 0;
  }
  .eyebrow {
    font-family: var(--display);
    text-transform: uppercase;
    color: var(--accent-on-primary);
    margin: 0 0 1.5rem;
  }
  .stairs {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    font-size: clamp(1.4rem, 3.5vw, 2.6rem);
    line-height: 1.25;
  }
  .stairs li:nth-child(2) {
    padding-left: 4%;
  }
  .stairs li:nth-child(3) {
    padding-left: 8%;
  }
  .stairs li:nth-child(4) {
    padding-left: 12%;
  }
  .stairs li:nth-child(5) {
    padding-left: 16%;
  }
  .stairs strong {
    font-family: var(--display);
    font-weight: 400;
    color: var(--accent-on-primary);
  }
  .punch {
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 1.5rem;
    max-width: 14ch;
  }
  .metier {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 600;
    margin: 0;
  }

  /* Preuve */
  .preuve {
    padding-top: clamp(3rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 9vw, 7rem);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .zero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .zero-num {
    font-family: var(--display);
    color: var(--primary);
    font-size: clamp(8rem, 22vw, 16rem);
    line-height: 0.8;
  }
  .zero-label {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.3;
  }
  blockquote {
    margin: 0;
    background: var(--secondary);
    color: var(--on-secondary);
    padding: 2rem;
    border-radius: 1.5rem;
  }
  blockquote p {
    font-size: 1.2rem;
    margin: 0 0 1rem;
  }
  blockquote footer {
    font-weight: 600;
  }

  /* Offres */
  .offres {
    background: var(--secondary);
    color: var(--on-secondary);
    padding: clamp(3rem, 9vw, 6rem) 0;
  }
  .offres h2 {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 0.95;
    margin: 0 0 0.5rem;
  }
  .offres-sub {
    font-size: 1.2rem;
    margin: 0 0 3rem;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .card {
    position: relative;
    background: var(--card);
    color: var(--on-card);
    border: 3px solid var(--border);
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card h3 {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--card-accent);
    font-size: 1.2rem;
    margin: 0;
  }
  .card p {
    margin: 0;
  }
  .card ul {
    margin: 0.5rem 0 1.5rem;
    padding-left: 1.2rem;
  }
  .card .btn {
    margin-top: auto;
    text-align: center;
  }
  .card-featured {
    background: var(--accent);
    color: var(--on-accent);
    transform: rotate(-1.5deg) translateY(-0.75rem);
    box-shadow: 8px 8px 0 var(--featured-shadow);
  }
  .card-featured h3,
  .card-featured .price {
    color: var(--on-accent);
  }
  .tag {
    position: absolute;
    top: -1rem;
    right: 1.25rem;
    background: var(--primary);
    color: var(--on-primary);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
  }
  .price {
    font-family: var(--display);
    font-size: 3rem;
    line-height: 1;
    color: var(--card-accent);
    margin-top: 0.5rem !important;
  }
  .price small {
    font-family: var(--text);
    font-size: 1rem;
    font-weight: 600;
  }
  .price-text {
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .meta {
    font-weight: 600;
    margin-bottom: 0.75rem !important;
  }
  .deliv {
    font-style: italic;
    padding-bottom: 1.5rem;
  }

  /* CTA final */
  .cta {
    padding-top: clamp(3rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 9vw, 7rem);
  }
  .cta h2 {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--primary);
    font-size: clamp(2.2rem, 6.5vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 2.5rem;
  }

  .foot {
    background: var(--primary);
    color: var(--on-primary);
    padding: 1.5rem 0;
    font-size: 0.85rem;
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Variante « calme » : mêmes couleurs et même structure, titres réduits d'environ 40 %. */
  .calme h1 {
    font-size: clamp(2.2rem, 6vw, 5.2rem);
    line-height: 0.95;
  }
  .calme .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }
  .calme .marquee {
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    padding: 0.5rem 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .calme .marquee-track {
      animation-duration: 50s;
    }
  }
  .calme .stairs {
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
  }
  .calme .punch {
    font-size: clamp(1.8rem, 4.2vw, 3.4rem);
    max-width: 16ch;
  }
  .calme .metier {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }
  .calme .zero-num {
    font-size: clamp(5rem, 12vw, 9rem);
  }
  .calme .zero-label {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
  }
  .calme .offres h2 {
    font-size: clamp(1.8rem, 3.8vw, 3rem);
  }
  .calme .price {
    font-size: 2.4rem;
  }
  .calme .price-text {
    font-size: 1.3rem;
  }
  .calme .cta h2 {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    max-width: 22ch;
  }

  @media (max-width: 800px) {
    .nav nav a:not(.btn) {
      display: none;
    }
    .logo {
      font-size: 0.85rem;
    }
    .preuve,
    .cards {
      grid-template-columns: 1fr;
    }
    .card-featured {
      order: -1;
      transform: none;
    }
    .stairs li {
      padding-left: 0 !important;
    }
  }
</style>
