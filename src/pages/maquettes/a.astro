---
// Maquette temporaire de l'étape 3 — piste A « Salle de contrôle ».
// À supprimer à l'étape 4, une fois la piste choisie.
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Maquette A · Salle de contrôle" description="Piste visuelle A pour l'accueil." noindex>
  <div class="status" role="status">
    <span class="dot" aria-hidden="true"></span>
    <span>prod</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>vendredi 16:47</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="ok">déploiement réussi ✓</span>
  </div>

  <header class="nav wrap">
    <a class="logo" href="#">guillaume<span>casbas</span></a>
    <nav aria-label="Navigation principale">
      <a href="#">Démarrer</a>
      <a href="#">Comment je travaille</a>
      <a href="#">À propos</a>
      <a class="btn btn-small" href="#">Me contacter</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <p class="kicker">// lead tech · contrôle des livraisons</p>
      <h1>Livrer <em>sans stress</em>, même quand l'IA écrit le code.</h1>
      <p class="lead">
        Je remets le contrôle dans vos livraisons : des process, des tests et du jugement,
        pour que votre équipe déploie sereinement.
      </p>
      <div class="actions">
        <a class="btn" href="#">Envoyez-moi un message</a>
        <a class="link" href="#offres">Voir les offres →</a>
      </div>
    </section>

    <section class="constat">
      <div class="wrap constat-grid">
        <div class="terminal" aria-label="Le constat">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>constat.log</span></div>
          <pre><code><span class="p">$</span> ia --vitesse-de-code
<span class="v">×3–4</span>  plus vite
<span class="p">$</span> features --demandées
<span class="v">×3–4</span>  plus de features
<span class="p">$</span> contexte --à-tenir
<span class="v">×3–4</span>  plus de contexte
<span class="p">$</span> bugs --en-prod
<span class="w">×3–4</span>  plus de bugs
<span class="p">$</span> stress --équipe
<span class="w">inchangé</span><span class="cursor" aria-hidden="true">▍</span></code></pre>
        </div>
        <div class="constat-text">
          <p class="kicker">// le constat</p>
          <h2>Ce qui devait nous libérer nous épuise.</h2>
          <p>
            L'IA permet de coder 3 à 4 fois plus vite. Alors on demande aux équipes 3 à 4 fois plus
            de features. Pour le même niveau de stress.
          </p>
          <p class="strong">Mon métier : remettre le contrôle dans ce circuit.</p>
        </div>
      </div>
    </section>

    <section class="preuve wrap">
      <p class="kicker">// la preuve</p>
      <div class="stats">
        <div class="stat">
          <span class="num">4 ans</span>
          <span class="label">de lead tech chez Medelse, web et mobile</span>
        </div>
        <div class="stat">
          <span class="num">5 000+</span>
          <span class="label">utilisateurs actifs</span>
        </div>
        <div class="stat stat-ok">
          <span class="num">0</span>
          <span class="label">interruption de service</span>
        </div>
      </div>
      <blockquote>
        <p>
          « Guillaume a été une personne clé au sein de Medelse pendant quatre ans. Il s'est
          distingué par son expertise technique, sa rigueur, son investissement et son esprit
          d'équipe. »
        </p>
        <footer><strong>Thomas Gendron</strong>, ex-CEO de Medelse</footer>
      </blockquote>
    </section>

    <section class="offres" id="offres">
      <div class="wrap">
        <p class="kicker">// comment on démarre</p>
        <h2>Prix fixes, périmètre écrit. Pas de surprise.</h2>
        <div class="cards">
          <article class="card">
            <h3>Session stratégie</h3>
            <p class="price">300 € <small>HT</small></p>
            <p class="meta">90 min · à distance</p>
            <p>On échange : vous me racontez votre façon de livrer, et vous me montrez ce qui coince.</p>
            <p class="deliv">→ Compte rendu : où vous en êtes, les options, la priorité recommandée.</p>
            <a class="btn btn-ghost" href="#">Prendre une session</a>
          </article>
          <article class="card card-featured">
            <span class="tag">Recommandé</span>
            <h3>Audit de livraison</h3>
            <p class="price">700 € <small>HT</small></p>
            <p class="meta">1 jour · sur place ou à distance</p>
            <p>Je constate par moi-même dans votre code et vos outils : pipeline, tests, déploiements, revues.</p>
            <p class="deliv">→ Compte rendu, plan d'action priorisé, checklists, restitution.</p>
            <a class="btn" href="#">Réserver un audit</a>
          </article>
          <article class="card">
            <h3>Missions</h3>
            <p class="price price-text">Chiffré après l'audit ou la session</p>
            <p class="meta">périmètre écrit · prix ferme</p>
            <ul>
              <li>Pipeline et tests critiques</li>
              <li>ATDD</li>
              <li>Lead tech à temps partiel</li>
            </ul>
            <a class="btn btn-ghost" href="#">Commencer par l'audit</a>
          </article>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap">
        <h2>Vous déboguez en prod plus souvent que vous ne l'aimeriez ?</h2>
        <a class="btn btn-dark" href="#">Envoyez-moi un message, on regarde ça ensemble</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <span>© Guillaume Casbas · Ce site ne collecte aucune donnée.</span>
    <a href="/maquettes">← Toutes les maquettes</a>
  </footer>
</BaseLayout>

<style>
  :global(:root) {
    --ink: #0e1714;
    --ink-2: #15231e;
    --green: #276955;
    --green-light: #5fb59a;
    --orange: #ff6f00;
    --paper: #f3efe6;
    --muted: #9fb3ab;
    --sans: 'Space Grotesk', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-weight: 500;
    line-height: 1.5;
  }
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  a {
    color: inherit;
  }

  /* Barre d'état */
  .status {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    align-items: center;
    padding: 0.4rem 1rem;
    background: var(--green);
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #9dffb0;
    box-shadow: 0 0 0.5rem #9dffb0;
  }
  .status span {
    white-space: nowrap;
  }
  .sep {
    opacity: 0.6;
  }
  @media (max-width: 480px) {
    .status {
      font-size: 0.72rem;
      gap: 0.4rem;
    }
  }
  .ok {
    font-weight: 700;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }
  .logo {
    font-family: var(--mono);
    font-weight: 700;
    text-decoration: none;
  }
  .logo span {
    color: var(--orange);
  }
  .nav nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    font-size: 0.95rem;
  }
  .nav nav a:not(.btn) {
    text-decoration: none;
    color: var(--muted);
  }

  /* Boutons */
  .btn {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    background: var(--orange);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--orange);
  }
  .btn:hover {
    background: transparent;
    color: var(--orange);
  }
  .btn-small {
    padding: 0.45rem 0.9rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--paper);
    border-color: var(--muted);
  }
  .btn-ghost:hover {
    border-color: var(--orange);
  }
  .btn-dark {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .btn-dark:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .link {
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  .kicker {
    font-family: var(--mono);
    color: var(--green-light);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  /* Hero */
  .hero {
    padding-top: clamp(3rem, 10vw, 7rem);
    padding-bottom: clamp(3rem, 10vw, 7rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 1.5rem;
    max-width: 15ch;
  }
  .hero em {
    font-style: normal;
    color: var(--orange);
  }
  .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    color: var(--muted);
    max-width: 38rem;
    margin: 0 0 2rem;
  }
  .actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Constat */
  .constat {
    background: var(--ink-2);
    padding: clamp(3rem, 8vw, 5rem) 0;
    border-top: 1px solid #22352e;
    border-bottom: 1px solid #22352e;
  }
  .constat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .terminal {
    background: #070d0b;
    border: 1px solid #22352e;
    font-family: var(--mono);
    font-size: 0.95rem;
  }
  .term-bar {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid #22352e;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .term-bar i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #33473f;
  }
  .term-bar span {
    margin-left: 0.5rem;
  }
  pre {
    margin: 0;
    padding: 1.25rem;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .p {
    color: var(--green-light);
  }
  .v {
    color: var(--paper);
    font-weight: 700;
  }
  .w {
    color: var(--orange);
    font-weight: 700;
  }
  .cursor {
    color: var(--orange);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .constat h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }
  .constat-text p {
    color: var(--muted);
    font-size: 1.1rem;
  }
  .constat-text .strong {
    color: var(--paper);
    font-weight: 700;
  }

  /* Preuve */
  .preuve {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #22352e;
    border: 1px solid #22352e;
    margin-bottom: 2.5rem;
  }
  .stat {
    background: var(--ink);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .num {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat-ok .num {
    color: var(--orange);
  }
  .label {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
  blockquote {
    margin: 0;
    max-width: 48rem;
    border-left: 3px solid var(--orange);
    padding-left: 1.5rem;
  }
  blockquote p {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    margin: 0 0 0.75rem;
  }
  blockquote footer {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Offres */
  .offres {
    background: var(--green);
    padding: clamp(3rem, 8vw, 5rem) 0;
  }
  .offres .kicker {
    color: #c9eadf;
  }
  .offres h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0 0 2.5rem;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 1.25rem;
    align-items: stretch;
  }
  .card {
    position: relative;
    background: var(--ink);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .card p {
    margin: 0;
  }
  .card ul {
    margin: 0.5rem 0;
    padding-left: 1.2rem;
  }
  .card .btn {
    margin-top: auto;
    text-align: center;
  }
  .card-featured {
    outline: 3px solid var(--orange);
    transform: translateY(-0.75rem);
  }
  .tag {
    position: absolute;
    top: -0.8rem;
    left: 1.5rem;
    background: var(--orange);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
  }
  .price {
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .price small {
    font-size: 1rem;
    color: var(--muted);
  }
  .price-text {
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--green-light);
    margin-bottom: 0.75rem !important;
  }
  .deliv {
    color: var(--muted);
    font-size: 0.95rem;
    padding-bottom: 1.25rem;
  }

  /* CTA final */
  .cta {
    background: var(--orange);
    color: var(--ink);
    padding: clamp(3rem, 8vw, 5rem) 0;
  }
  .cta h2 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
    max-width: 20ch;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    padding-bottom: 2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .nav nav a:not(.btn) {
      display: none;
    }
    .constat-grid,
    .cards {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    .card-featured {
      transform: none;
      order: -1;
    }
  }
</style>
