---
// Maquette temporaire de l'étape 3 — piste C « Sérénité ».
// À supprimer à l'étape 4, une fois la piste choisie.
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Maquette C · Sérénité" description="Piste visuelle C pour l'accueil." noindex>
  <header class="nav wrap">
    <a class="logo" href="#">Guillaume Casbas</a>
    <nav aria-label="Navigation principale">
      <a href="#">Démarrer</a>
      <a href="#">Comment je travaille</a>
      <a href="#">À propos</a>
      <a class="btn btn-small" href="#">Me contacter</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <div class="hero-text">
        <h1>Livrer <em>sans stress</em>, même quand l'IA écrit le code.</h1>
        <p class="lead">
          Je remets le contrôle dans vos livraisons : des process, des tests et du jugement,
          pour que votre équipe déploie sereinement.
        </p>
        <a class="btn" href="#">Envoyez-moi un message</a>
      </div>
      <div class="hero-field" aria-hidden="true">
        <div class="sun"></div>
        <p class="field-day">Vendredi,<br />16 h 47.</p>
        <p class="field-note">Mise en prod terminée. Tout le monde rentre chez soi.</p>
      </div>
    </section>

    <section class="constat">
      <div class="wrap narrow">
        <p class="eyebrow">Le constat</p>
        <p class="constat-lines">
          L'IA permet de coder <span>3 à 4 fois</span> plus vite.
          Alors on demande aux équipes <span>3 à 4 fois</span> plus de features.
          Mécaniquement : <span>3 à 4 fois</span> plus de contexte, <span>3 à 4 fois</span> plus de bugs.
          Pour le même niveau de stress.
        </p>
        <p class="constat-punch">Ce qui devait nous libérer nous épuise.</p>
        <p class="metier">Mon métier&nbsp;: <strong>remettre le contrôle dans ce circuit.</strong></p>
      </div>
    </section>

    <section class="preuve wrap">
      <div class="preuve-card">
        <div class="preuve-figure">
          <span class="big">0</span>
          <span class="big-label">interruption de service</span>
        </div>
        <p class="preuve-text">
          En <strong>4 ans</strong> de lead tech chez Medelse, sur le web et le mobile,
          pour plus de <strong>5 000 utilisateurs</strong>. Des tests, une QA sérieuse, des revues exigeantes, et une
          équipe qui tenait la barre avec moi.
        </p>
      </div>
      <blockquote>
        <p>
          « Guillaume a été une personne clé au sein de Medelse pendant quatre ans. Il s'est
          distingué par son expertise technique, sa rigueur, son investissement et son esprit
          d'équipe. »
        </p>
        <footer><strong>Thomas Gendron</strong> · ex-CEO de Medelse</footer>
      </blockquote>
    </section>

    <section class="offres" id="offres">
      <div class="wrap">
        <p class="eyebrow">Comment on démarre</p>
        <h2>Prix fixes, périmètre écrit. Pas de surprise.</h2>
        <div class="cards">
          <article class="card">
            <h3>Session stratégie</h3>
            <p class="price">300 €<small> HT</small></p>
            <p class="meta">90 minutes · à distance</p>
            <p>On échange : vous me racontez votre façon de livrer, et vous me montrez ce qui coince.</p>
            <p class="deliv">Compte rendu : où vous en êtes, les options, la priorité recommandée.</p>
            <a class="btn btn-soft" href="#">Prendre une session</a>
          </article>
          <article class="card card-featured">
            <span class="tag">Recommandé</span>
            <h3>Audit de livraison</h3>
            <p class="price">700 €<small> HT</small></p>
            <p class="meta">1 jour · sur place ou à distance</p>
            <p>Je constate par moi-même dans votre code et vos outils : pipeline, tests, déploiements, revues.</p>
            <p class="deliv">Compte rendu, plan d'action priorisé, checklists, restitution.</p>
            <a class="btn" href="#">Réserver un audit</a>
          </article>
          <article class="card">
            <h3>Missions</h3>
            <p class="price price-text">Chiffré après l'audit ou la session</p>
            <p class="meta">périmètre écrit · prix ferme</p>
            <ul>
              <li>Pipeline et tests critiques</li>
              <li>ATDD</li>
              <li>Lead tech à temps partiel</li>
            </ul>
            <a class="btn btn-soft" href="#">Commencer par l'audit</a>
          </article>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap narrow">
        <h2>Vous déboguez en prod plus souvent que vous ne l'aimeriez&nbsp;?</h2>
        <a class="btn" href="#">Envoyez-moi un message, on regarde ça ensemble</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <span>© Guillaume Casbas · Ce site ne collecte aucune donnée.</span>
    <a href="/maquettes">← Toutes les maquettes</a>
  </footer>
</BaseLayout>

<style>
  :global(:root) {
    --bg: #f4f1ea;
    --green: #276955;
    --green-deep: #173f33;
    --green-soft: #dfe9e3;
    --orange: #ff6f00;
    --burgundy: #6d001b;
    --text: #1d2a25;
    --muted: #5b6b64;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    line-height: 1.6;
  }
  .wrap {
    max-width: 74rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .narrow {
    max-width: 52rem;
  }
  a {
    color: inherit;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .logo {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--green-deep);
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-weight: 500;
  }
  .nav nav a:not(.btn) {
    text-decoration: none;
    color: var(--muted);
  }

  /* Boutons */
  .btn {
    display: inline-block;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    background: var(--orange);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .btn:hover {
    background: var(--green-deep);
    color: #fff;
  }
  .btn-small {
    padding: 0.55rem 1.1rem;
    white-space: nowrap;
  }
  .btn-soft {
    background: var(--green-soft);
    color: var(--green-deep);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--green);
    margin: 0 0 1.25rem;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: clamp(2rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.6rem, 6.5vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--green-deep);
    margin: 0 0 1.5rem;
  }
  h1 em {
    color: var(--green);
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 2.25rem;
  }
  .hero-field {
    position: relative;
    overflow: hidden;
    background: var(--green);
    color: #fff;
    border-radius: 2.5rem 2.5rem 2.5rem 0.5rem;
    min-height: 26rem;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .sun {
    position: absolute;
    top: -4rem;
    right: -4rem;
    width: 16rem;
    height: 16rem;
    border-radius: 50%;
    background: var(--orange);
    opacity: 0.9;
  }
  .field-day {
    position: relative;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1;
    margin: 0 0 1rem;
  }
  .field-note {
    position: relative;
    margin: 0;
    max-width: 18rem;
    opacity: 0.9;
  }

  /* Constat */
  .constat {
    background: var(--green-soft);
    padding: clamp(4rem, 10vw, 7rem) 0;
    text-align: center;
  }
  .constat-lines {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    line-height: 1.5;
    margin: 0 0 2.5rem;
  }
  .constat-lines span {
    color: var(--green);
    font-weight: 600;
  }
  .constat-punch {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
    color: var(--green-deep);
    margin: 0 0 2rem;
  }
  .metier {
    font-size: 1.15rem;
    margin: 0;
  }

  /* Preuve */
  .preuve {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: stretch;
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }
  .preuve-card {
    background: #fff;
    border-radius: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 1.5rem 3rem -2rem rgba(23, 63, 51, 0.35);
  }
  .preuve-figure {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .big {
    font-family: var(--serif);
    font-size: clamp(5rem, 12vw, 8rem);
    line-height: 0.9;
    color: var(--orange);
  }
  .big-label {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--green-deep);
  }
  .preuve-text {
    margin: 0;
    font-size: 1.1rem;
    color: var(--muted);
  }
  blockquote {
    margin: 0;
    background: var(--green-deep);
    color: #fff;
    border-radius: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.45;
    margin: 0;
  }
  blockquote footer {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  /* Offres */
  .offres {
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }
  .offres h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    color: var(--green-deep);
    margin: 0 0 2.5rem;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .card {
    position: relative;
    background: #fff;
    border-radius: 2rem;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--green-deep);
    margin: 0;
  }
  .card p {
    margin: 0;
  }
  .card ul {
    margin: 0.5rem 0 1.5rem;
    padding-left: 1.2rem;
  }
  .card .btn {
    margin-top: auto;
    text-align: center;
  }
  .card-featured {
    background: var(--green);
    color: #fff;
    transform: translateY(-1rem);
    box-shadow: 0 2rem 3rem -2rem rgba(23, 63, 51, 0.6);
  }
  .card-featured h3,
  .card-featured .price,
  .card-featured .meta {
    color: #fff;
  }
  .tag {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: var(--orange);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }
  .price {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1.1;
    color: var(--green-deep);
    margin-top: 0.5rem !important;
  }
  .price small {
    font-family: var(--sans);
    font-size: 1rem;
  }
  .price-text {
    font-size: 1.5rem;
  }
  .meta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green);
    margin-bottom: 0.75rem !important;
  }
  .deliv {
    opacity: 0.85;
    padding-bottom: 1.5rem;
  }

  /* CTA final */
  .cta {
    background: var(--green);
    color: #fff;
    text-align: center;
    padding: clamp(4rem, 10vw, 7rem) 0;
    border-radius: 2.5rem 2.5rem 0 0;
  }
  .cta h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.1;
    margin: 0 0 2.5rem;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    padding-bottom: 2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .nav nav a:not(.btn) {
      display: none;
    }
    .hero,
    .preuve,
    .cards {
      grid-template-columns: 1fr;
    }
    .hero-field {
      min-height: 16rem;
    }
    .sun {
      width: 9rem;
      height: 9rem;
      top: -3rem;
      right: -3rem;
    }
    .card-featured {
      order: -1;
      transform: none;
    }
  }
</style>
